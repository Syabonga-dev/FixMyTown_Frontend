# Base URL of the ASP.NET Core backend (no trailing slash).
# All requests in src/services/api/client.js are built from this.
VITE_API_BASE_URL=https://localhost:5174

# Google Maps JavaScript API key, used only by src/components/maps/ClinicMap.jsx
# for the Clinic Finder screen. Restrict this key to your domain in the
# Google Cloud Console. Never put your Anthropic key or any other secret here —
# anything prefixed VITE_ is bundled into the client JS and is public.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: name shown when the token is about to expire / for display only
VITE_APP_NAME=PhilaLink
